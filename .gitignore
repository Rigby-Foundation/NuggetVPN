.DS_Store

# Frontend
node_modules
frontend/dist
frontend/bindings
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Build output
bin/

# Generated build assets (build/appicon.png and the platform templates are tracked)
build/darwin/icons.icns
build/darwin/Assets.car
build/linux/*.desktop
build/linux/appimage/build
build/linux/appimage/*.png
build/linux/appimage/NuggetVPN
# Windows resource objects. Wails v3 writes the one it links into the binary at
# the repository root, not under build/windows/, so both are covered.
*.syso

.env
.env.*
!.env.example
nuggetvpn-logs.txt

# Task runner and TypeScript incremental caches
.task/
frontend/*.md5
frontend/tsconfig.tsbuildinfo

# Mobile scaffolding regenerated by `wails3 task common:update:build-assets`.
# iOS is not built. The Android project is ours (see build/android/Taskfile.yml);
# only its build outputs are ignored.
build/ios/
build/android/.gradle/
build/android/app/build/
build/android/app/src/main/jniLibs/
build/android/local.properties
build/android/overlay.json
build/android/gen/

# sing-box cache file, written by the core at runtime
cache.db
*.nuggetplugin
